# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 참고용 외부 문서(공공데이터포털 활용가이드 등)는 올리지 않는다
.claude/*.docx

# 테스트 계정 SQL(비밀번호 평문 포함). 로컬에만 둔다
supabase/test-users.sql
# Supabase CLI가 만드는 임시 폴더(버전 확인, 프로젝트 연결 정보)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
